# Anthropic (required for the AI coach in /flow/*)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (optional in v1 — leads/sessions/reports persist locally to the
# browser via localStorage regardless; these enable server-side persistence
# so Kenneth can see leads and usage. Use the service role key, not anon,
# since writes happen from API routes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payment enforcement. false (default): checkout shows a real-looking
# payment UI but "Pay" and "Skip Payment (Beta Access)" both proceed to the
# flow with no real charge. true: wires the same UI to a real processor —
# see the TODO in app/checkout/checkout-client.tsx.
NEXT_PUBLIC_ENFORCE_PAYMENT=false
